{
  "manifest_version": 3,
  "name": "Leaf Downloader",
  "version": "1.0.0",
  "description": "Send video URLs to Leaf-Downloader desktop app for downloading with yt-dlp.",
  "author": "Leaf-Downloader",

  "permissions": [
    "activeTab"
  ],

  "host_permissions": [
    "http://127.0.0.1:9549/*"
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Leaf Downloader"
  },

  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "leaf-downloader@example.com",
      "strict_min_version": "109.0"
    }
  }
}
